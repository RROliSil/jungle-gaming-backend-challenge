{
  "name": "jungle-gaming-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor — Jungle Gaming Backend Challenge (NestJS, Bun, MikroORM, PostgreSQL, AWS SQS, CRUD, WebSockets)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "start:prod": "bun run dist/src/main.js",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "bun run scripts/run-migrations.ts up",
    "migration:down": "bun run scripts/run-migrations.ts down",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run scripts/load-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/migrations": "^6.4.3",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/websockets": "^10.4.15",
    "decimal.js": "^10.4.3",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "bun": "^1.1.42",
    "typescript": "^5.7.2"
  }
}
